{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "Edit",
      "MultiEdit",
      "Write(backend/**)",
      "Write(frontend/src/**)",
      "Write(frontend/package.json)",
      "Write(frontend/vite.config.js)",
      "Write(frontend/.env.example)",
      "Write(storage/**)",
      "Write(ansible/**)",
      "Write(PROJECT_DOCS/**)",
      "Write(PROJECT_README.md)",
      "Write(PROJECT_STRUCTURE.md)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm install *)",
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(python3 -m venv *)",
      "Bash(pip install *)",
      "Bash(pip install -r *)",
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(ruff *)",
      "Bash(alembic *)",
      "Bash(uvicorn *)",
      "Bash(ansible-playbook *)",
      "Bash(ansible-vault *)",
      "Bash(ansible-galaxy *)",
      "Bash(ansible *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(source *)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(.vault_pass)",
      "Read(**/secrets/**)",
      "Write(.env*)",
      "Write(.vault_pass)",
      "Write(production.*)",
      "Write(.github/workflows/*)",
      "Write(package-lock.json)",
      "Write(frontend/dist/**)",
      "Write(local-deploy/Vagrantfile)",
      "Write(local-deploy/inventory.ini)",
      "Write(provisioning/**)",
      "Write(PROJECT_DOCS/ASSIGNMENT.md)",
      "Write(PROJECT_DOCS/CLAUDEBEHAVIOR.md)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm publish *)",
      "Bash(docker *)",
      "Bash(curl * | sh)",
      "Bash(wget *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(vagrant *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(backend/app/**/*.py)",
        "hooks": [
          {
            "type": "command",
            "command": "cd backend && source venv/bin/activate 2>/dev/null && ruff check $file --fix && mypy $file"
          }
        ]
      },
      {
        "matcher": "Write(frontend/src/**/*.jsx)",
        "hooks": [
          {
            "type": "command",
            "command": "cd frontend && npx prettier --write $file"
          }
        ]
      },
      {
        "matcher": "Write(frontend/src/**/*.js)",
        "hooks": [
          {
            "type": "command",
            "command": "cd frontend && npx prettier --write $file"
          }
        ]
      }
    ]
  }
}
