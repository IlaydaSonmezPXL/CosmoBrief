# Copy to .env and fill in. Read by docker compose.

# Postgres
POSTGRES_DB=cosmobrief
POSTGRES_USER=cosmobrief
POSTGRES_PASSWORD=

# Backend auth — generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Seeded admin account (created on first start)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=

# External APIs (optional — related features won't work without them)
OPENAI_API_KEY=
ASTRONOMY_APP_ID=
ASTRONOMY_APP_SECRET=
