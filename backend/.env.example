# Copy to .env and fill in values for local development.
# In production, Ansible renders this file from ansible/roles/backend/templates/cosmobrief.env.j2

DATABASE_URL=postgresql+asyncpg://cosmobrief:changeme@localhost:5432/cosmobrief
JWT_SECRET_KEY=changeme_at_least_32_chars_random_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OPENAI_API_KEY=sk-your-openai-api-key
SNAPI_CACHE_TTL_MINUTES=15
